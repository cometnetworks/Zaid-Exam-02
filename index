<!doctype html>
<html lang="es">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title>Examen de Zaíd (1° Primaria)</title>
  <style>
    :root { --bg:#0b1220; --card:#121b2e; --text:#e8eefc; --muted:#a9b7d6; --ok:#29c77a; --bad:#ff5c6c; --accent:#67b0ff; }
    body { margin:0; font-family: system-ui, -apple-system, Segoe UI, Roboto, Arial; background:var(--bg); color:var(--text); }
    .wrap { max-width: 980px; margin: 0 auto; padding: 18px; }
    .card { background:var(--card); border:1px solid rgba(255,255,255,.08); border-radius:16px; padding:16px; box-shadow: 0 12px 30px rgba(0,0,0,.25); }
    h1 { font-size: 20px; margin: 0 0 10px; }
    h2 { font-size: 16px; margin: 0 0 10px; color: var(--muted); font-weight: 600; }
    label { display:block; margin: 10px 0 6px; color: var(--muted); }
    select, button { width:100%; font-size: 16px; padding: 12px 12px; border-radius: 12px; border: 1px solid rgba(255,255,255,.12); background: #0e1730; color: var(--text); }
    button { cursor:pointer; border-color: rgba(103,176,255,.35); }
    button:hover { border-color: rgba(103,176,255,.75); }
    .row { display:grid; grid-template-columns: 1fr 1fr; gap: 12px; }
    .row3 { display:grid; grid-template-columns: 1fr 1fr 1fr; gap: 12px; }
    .small { font-size: 13px; color: var(--muted); }
    .pill { display:inline-block; padding: 4px 10px; border-radius: 999px; border:1px solid rgba(255,255,255,.14); color: var(--muted); font-size: 12px; }
    .topbar { display:flex; align-items:center; justify-content:space-between; gap: 10px; margin-bottom: 10px; flex-wrap: wrap; }
    .q { font-size: 20px; line-height: 1.25; margin: 10px 0 14px; }
    .opts { display:grid; gap: 10px; }
    .opt { text-align:left; background:#0e1730; border: 1px solid rgba(255,255,255,.12); }
    .opt.correct { border-color: rgba(41,199,122,.9); }
    .opt.wrong { border-color: rgba(255,92,108,.9); }
    .feedback { margin-top: 12px; font-size: 16px; }
    .feedback.ok { color: var(--ok); }
    .feedback.bad { color: var(--bad); }
    .actions { display:flex; gap: 10px; margin-top: 14px; }
    .actions button { width:auto; flex:1; }
    .hidden { display:none; }
    .kbd { font-family: ui-monospace, SFMono-Regular, Menlo, monospace; background: rgba(255,255,255,.08); padding:2px 6px; border-radius: 6px; border:1px solid rgba(255,255,255,.12); }
    .footer { margin-top: 12px; opacity:.95; }
    .hr { height:1px; background:rgba(255,255,255,.08); margin: 12px 0; }
