  }
};

// Inglés
function genEnglishColorQuestion(difficulty){
  const color = choice(GEN_DATA.ingles.colors);
  return makeMCQ({
    id: `gen-ing-col-${color}-${Date.now()}-${Math.random().toString(16).slice(2)}`,
    subject: "Inglés",
    topic: "Colors Everywhere",
    prompt: "¿Cuál palabra es un color?",
    correct: color,
    distractors: [choice(GEN_DATA.ingles.family), choice(GEN_DATA.ingles.snacks), ...shuffle(GEN_DATA.ingles.colors.filter(c=>c!==color)).slice(0,1)],
    difficulty
  });
}
function genEnglishFamilyQuestion(difficulty){
  const fam = choice(GEN_DATA.ingles.family);
  return makeMCQ({
    id: `gen-ing-fam-${fam}-${Date.now()}-${Math.random().toString(16).slice(2)}`,
    subject: "Inglés",
    topic: "My Family",
    prompt: "¿Cuál palabra es de la familia?",
    correct: fam,
    distractors: [choice(GEN_DATA.ingles.colors), choice(GEN_DATA.ingles.snacks), ...shuffle(GEN_DATA.ingles.family.filter(x=>x!==fam)).slice(0,1)],
    difficulty
  });
}
function genThereIsAreQuestion(difficulty){
  const plural = Math.random() < 0.5;
  return makeMCQ({
    id: `gen-ing-there-${plural?"are":"is"}-${Date.now()}-${Math.random().toString(16).slice(2)}`,
    subject: "Inglés",
