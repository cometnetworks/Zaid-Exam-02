// Lista final de generadores
const GENERATORS = [
  // Español
  genSpanishPunctuationQuestion,
  genSpanishStoryPartsQuestion,
  genSpanishMainSecondaryQuestion,
  genSpanishLetterPartsQuestion,

  // Inglés
  genEnglishColorQuestion,
  genEnglishFamilyQuestion,
  genThereIsAreQuestion,

  // Matemáticas
  genMathUnitsTensQuestion,
  genMathShapesQuestion,
  genDaysSequenceQuestion,

  // Ética
  genBioticAbioticQuestion,
  genPushPullQuestion
];

function generateQuestions(subject, count, variants, difficulty){
  const pool = [];
  const target = Math.max(count * variants, count);

  const gens = GENERATORS.filter(fn => {
    const name = fn.name;
    if (subject === "Mixto") return true;
    if (subject === "Español") return name.includes("Spanish");
    if (subject === "Matemáticas") return name.includes("Math") || name.includes("Days");
    if (subject === "Inglés") return name.includes("English") || name.includes("There");
    if (subject === "Ética") return name.includes("Biotic") || name.includes("Push");
    return true;
  });

  if (!gens.length) return [];

  while (pool.length < target) {
    pool.push(choice(gens)(difficulty));
  }
  return shuffle(pool).slice(0, count);
}

/* -------------------------
   MOTOR DEL QUIZ
-------------------------- */
let session = {
  subject: "Mixto",
  mode: "practice",
  total: 10,
  index: 0,
  questions: [],
  answers: [],
  tutorMode: false,
  locked: false,
  source: "mixed",
  variants: 2,
  difficulty: "easy"
};

function bySubjectFromBank(subject) {
  if (subject === "Mixto") return BANK.slice();
  if (subject === "Ética") return BANK.filter(q => q.subject === "Ética");
  return BANK.filter(q => q.subject === subject);
}

function pickFromBank(subject, total, doShuffle) {
  let pool = bySubjectFromBank(subject);
  if (doShuffle) pool = shuffle(pool);
  const chosen = [];
  let k = 0;
  while (chosen.length < total) {
    chosen.push(pool[k % pool.length]);
    k++;
  }
  return chosen.slice(0, total);
}

function mergeUnique(a,b){
  const map = new Map();
  [...a,...b].forEach(q => map.set(q.id, q));
  return Array.from(map.values());
}

function buildSessionQuestions({subject,total,doShuffle,source,variants,difficulty}){
  let qs = [];
  if (source === "bank") {
    qs = pickFromBank(subject, total, doShuffle);
  } else if (source === "generated") {
    const gen = generateQuestions(subject, total, variants, difficulty);
    qs = gen.length ? gen : pickFromBank(subject, total, doShuffle);
  } else {
    const half = Math.ceil(total/2);
    const bankPart = pickFromBank(subject, half, doShuffle);
    const genPart = generateQuestions(subject, total - half, variants, difficulty);
    qs = mergeUnique(bankPart, genPart);
    if (qs.length < total) {
      const extra = pickFromBank(subject, total - qs.length, true);
      qs = qs.concat(extra);
    }
    qs = doShuffle ? shuffle(qs) : qs;
    qs = qs.slice(0,total);
  }
  return qs;
}

// DOM
const screenSetup = document.getElementById("screen-setup");
const screenQuiz = document.getElementById("screen-quiz");
const screenResults = document.getElementById("screen-results");

const subjectSel = document.getElementById("subject");
const countSel = document.getElementById("count");
const modeSel = document.getElementById("mode");
const shuffleSel = document.getElementById("shuffle");
const sourceSel = document.getElementById("source");
const variantsSel = document.getElementById("variants");
const difficultySel = document.getElementById("difficulty");

const startBtn = document.getElementById("startBtn");
const nextBtn = document.getElementById("nextBtn");
const revealBtn = document.getElementById("revealBtn");
const againBtn = document.getElementById("againBtn");

const progressPill = document.getElementById("progressPill");
const subjectPill = document.getElementById("subjectPill");
const sourcePill = document.getElementById("sourcePill");
const tutorPill = document.getElementById("tutorPill");
const topicLine = document.getElementById("topicLine");
const promptEl = document.getElementById("prompt");
const optionsEl = document.getElementById("options");
const feedbackEl = document.getElementById("feedback");
const hintLine = document.getElementById("hintLine");

const scoreLine = document.getElementById("scoreLine");
const reviewEl = document.getElementById("review");

function show(el) { el.classList.remove("hidden"); }
function hide(el) { el.classList.add("hidden"); }
function go(screen) { hide(screenSetup); hide(screenQuiz); hide(screenResults); show(screen); }

function explainIfAvailable(q){
  if (!q.explanation) return "";
  return `💡 ${q.explanation}`;
}

function renderTutorUI() {
  if (session.tutorMode) {
    show(tutorPill);
    show(revealBtn);
    hintLine.textContent = "Modo tutor activo: puedes revelar la respuesta correcta.";
  } else {
    hide(tutorPill);
    hide(revealBtn);
    hintLine.textContent = session.mode === "practice"
      ? "Tip: En práctica te avisa al momento."
      : "Tip: En examen, resultados al final.";
  }
}

function renderQuestion() {
  const q = session.questions[session.index];
  session.locked = false;
  nextBtn.disabled = true;
  feedbackEl.textContent = "";
  feedbackEl.className = "feedback hidden";

  progressPill.textContent = `${session.index + 1}/${session.total}`;
  subjectPill.textContent = session.subject === "Ética" ? "Ética, Naturaleza y Sociedades" : session.subject;
  sourcePill.textContent = session.source === "mixed" ? "Mixto" : (session.source === "bank" ? "Banco" : "Generadas");
  topicLine.textContent = `Tema: ${q.topic}`;
  promptEl.textContent = q.prompt;

  optionsEl.innerHTML = "";
  q.options.forEach((opt, idx) => {
    const btn = document.createElement("button");
    btn.className = "opt";
    btn.textContent = opt;
    btn.onclick = () => choose(idx);
    optionsEl.appendChild(btn);
  });

  renderTutorUI();
}

function markOptions(chosenIndex) {
  const q = session.questions[session.index];
  const btns = Array.from(optionsEl.querySelectorAll("button"));
  btns.forEach((b, i) => {
    b.disabled = true;
    if (i === q.answerIndex) b.classList.add("correct");
    if (i === chosenIndex && i !== q.answerIndex) b.classList.add("wrong");
  });
}

function choose(chosenIndex) {
  if (session.locked) return;
  session.locked = true;

  const q = session.questions[session.index];
  const correct = chosenIndex === q.answerIndex;
  session.answers.push({ qid: q.id, chosenIndex, correct });

  markOptions(chosenIndex);
  nextBtn.disabled = false;

  if (session.mode === "practice") {
    feedbackEl.classList.remove("hidden");
    feedbackEl.classList.add(correct ? "ok" : "bad");
    const extra = correct ? "" : (q.explanation ? `\n${explainIfAvailable(q)}` : "");
    feedbackEl.textContent = correct ? "✅ ¡Correcto!" : `❌ Ups. La correcta era: "${q.options[q.answerIndex]}".${extra}`;
  }
}

function revealCorrect() {
  if (!session.tutorMode) return;
  const q = session.questions[session.index];
  const btns = Array.from(optionsEl.querySelectorAll("button"));
  btns.forEach((b, i) => { if (i === q.answerIndex) b.classList.add("correct"); });
  feedbackEl.classList.remove("hidden");
  feedbackEl.classList.remove("bad");
  feedbackEl.classList.add("ok");
  feedbackEl.textContent = `👁 Correcta: "${q.options[q.answerIndex]}". ${explainIfAvailable(q)}`.trim();
}

function next() {
  if (session.index < session.total - 1) {
    session.index++;
    renderQuestion();
  } else {
    renderResults();
  }
}

function renderResults() {
  const correctCount = session.answers.filter(a => a.correct).length;
  scoreLine.textContent = `Aciertos: ${correctCount} / ${session.total}`;

  reviewEl.innerHTML = "";
  const ul = document.createElement("ul");
  ul.style.lineHeight = "1.55";
  ul.style.paddingLeft = "18px";

  session.questions.forEach((q, i) => {
    const a = session.answers[i];
    const li = document.createElement("li");
    const status = a.correct ? "✅" : "❌";
    li.innerHTML = `<strong>${status}</strong> ${q.prompt}<br><span class="small">Tu respuesta: "${q.options[a.chosenIndex]}"</span>`;
    if (!a.correct) {
      if (session.tutorMode) {
        li.innerHTML += `<br><span class="small" style="color: var(--ok);">Correcta: "${q.options[q.answerIndex]}"</span>`;
        if (q.explanation) li.innerHTML += `<br><span class="small">${explainIfAvailable(q)}</span>`;
      } else {
        li.innerHTML += `<br><span class="small">Activa modo tutor para ver correctas (truco ALINA).</span>`;
      }
    }
    ul.appendChild(li);
  });

  reviewEl.appendChild(ul);
  go(screenResults);
}

// Eventos
startBtn.addEventListener("click", () => {
  session.subject = subjectSel.value;
  session.mode = modeSel.value;
  session.total = parseInt(countSel.value, 10);
  session.source = sourceSel.value;
  session.variants = parseInt(variantsSel.value, 10);
  session.difficulty = difficultySel.value;

  const doShuffle = shuffleSel.value === "yes";

  session.index = 0;
  session.answers = [];
  session.questions = buildSessionQuestions({
    subject: session.subject,
    total: session.total,
    doShuffle,
    source: session.source,
    variants: session.variants,
    difficulty: session.difficulty
  });

  go(screenQuiz);
  renderQuestion();
});

nextBtn.addEventListener("click", next);
revealBtn.addEventListener("click", revealCorrect);
againBtn.addEventListener("click", () => go(screenSetup));

// Modo tutor oculto: "ALINA"
let buffer = "";
window.addEventListener("keydown", (e) => {
  if (e.key.length !== 1) return;
  buffer += e.key.toUpperCase();
  if (buffer.length > 10) buffer = buffer.slice(-10);
  if (buffer.endsWith("ALINA")) {
    session.tutorMode = !session.tutorMode;
    buffer = "";
    if (!screenQuiz.classList.contains("hidden")) renderTutorUI();
  }
});
</script>
