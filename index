/* -------------------------
   UTILIDADES
-------------------------- */
function randInt(a,b){ return Math.floor(Math.random()*(b-a+1))+a; }
function choice(arr){ return arr[randInt(0, arr.length-1)]; }
function shuffle(arr){
  const a = arr.slice();
  for (let i=a.length-1;i>0;i--){
    const j=Math.floor(Math.random()*(i+1));
    [a[i],a[j]]=[a[j],a[i]];
  }
  return a;
}
function uniq(arr){ return Array.from(new Set(arr)); }

function makeMCQ({id, subject, topic, prompt, correct, distractors, difficulty="easy"}) {
  let options = [correct, ...distractors];
  options = uniq(options);
  while (options.length < 3) options.push("Ninguna de las anteriores");
  if (difficulty === "normal") {
    while (options.length < 4) options.push("No estoy seguro");
  } else {
    options = options.slice(0,3);
  }
  options = shuffle(options);
  const answerIndex = options.indexOf(correct);
  return { id, subject, topic, prompt, options, answerIndex };
}

